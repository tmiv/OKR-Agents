ANTHROPIC_API_KEY=sk-ant-...
PORT=8787

# Browser origins allowed to call this service, comma-separated. A full origin —
# scheme://host[:port] — not a bare hostname. Defaults to the Vite dev server.
# With the compose stack this is the web container's published port; in
# production it is the app's real URL. `*` disables the check.
APP_ORIGIN=http://localhost:5173
