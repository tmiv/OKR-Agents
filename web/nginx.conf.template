# Rendered at container start by nginx's own entrypoint (envsubst over
# /etc/nginx/templates/*.template), so ${SERVICE_URL} is baked in before nginx
# reads it — no runtime resolver, no variable in proxy_pass.
#
# This is the production counterpart to the Vite dev proxy in vite.config.js:
# the browser only ever talks to this origin, so there is no CORS to configure
# and ANTHROPIC_API_KEY stays inside the service container.

server {
    listen       ${NGINX_PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;
    client_max_body_size 0; 

    gzip             on;
    gzip_types       text/css application/javascript application/json image/svg+xml;
    gzip_min_length  1024;

    # Vite fingerprints everything under assets/, so it can be cached hard.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files  $uri =404;
    }

    location /api/ {
        proxy_pass         ${SERVICE_URL};
        proxy_http_version 1.1;
    
        # Critical for external HTTPS upstreams (Cloud Run expects SNI)
        proxy_ssl_server_name on;
        proxy_ssl_session_reuse off;
    
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    
        proxy_read_timeout 300s;
        proxy_buffering    off;
    }

    # index.html is the app shell and must never be served stale, or a browser
    # keeps asking for asset hashes that the new build no longer has.
    location / {
        try_files  $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
