  "company": {
    "name": "Workflow platform",
    "units": [
      {
        "id": "exec",
        "name": "Exec",
        "parent": null,
        "charter": {
          "mission": "We set one company goal a year and make sure every team's work ladders up to it. Our real product is the list of things the company has decided not to do.",
          "process": "Board targets come in once a year and a single company objective goes out. Each division brings its objectives to a monthly business review; anything that needs a trade-off between two divisions is settled there rather than in a hallway.",
          "owns": [
            "the company objective",
            "the annual operating plan",
            "headcount allocation",
            "the board narrative"
          ]
        }
      },
      {
        "id": "product",
        "name": "Product",
        "parent": "exec",
        "charter": {
          "mission": "We decide what gets built and why, so the platform earns its price for a mid-market team and not only for the enterprises that already bought it.",
          "process": "Customer research, support themes and usage data come in. We run a monthly roadmap review with Engineering and Design, then publish a quarterly commitment that Marketing and Sales can plan their own quarters against.",
          "owns": [
            "the product roadmap",
            "week-1 activation",
            "pricing and packaging",
            "what ships behind a flag"
          ],
          "dependsOn": [
            "engineering",
            "design"
          ]
        }
      },
      {
        "id": "marketing",
        "name": "Marketing",
        "parent": "exec",
        "charter": {
          "mission": "We create demand that Sales can actually work, and we make the product understandable before anyone has to talk to a human about it.",
          "process": "We plan a quarter ahead against the pipeline number Sales needs, execute through Content and Field Marketing, and review pipeline contribution weekly with Sales Ops. Campaigns that do not tie to a pipeline number do not get run.",
          "owns": [
            "the demand generation number",
            "the website",
            "brand and messaging",
            "the event calendar"
          ],
          "dependsOn": [
            "product",
            "sales"
          ]
        }
      },
      {
        "id": "sales",
        "name": "Sales",
        "parent": "exec",
        "charter": {
          "mission": "We turn qualified demand into paying mid-market teams, and we keep them paying.",
          "process": "A weekly forecast runs off the pipeline Marketing generates. Discovery and trials are run with Customer Success, and deals close on the standard contract; anything non-standard goes to Sales Ops for approval before it is promised.",
          "owns": [
            "new ARR",
            "net revenue retention",
            "the CRM",
            "discounting policy"
          ],
          "dependsOn": [
            "marketing",
            "product"
          ]
        }
      },
      {
        "id": "engineering",
        "name": "Engineering",
        "parent": "exec",
        "charter": {
          "mission": "We build and run the platform, and we keep it fast and available enough that no other team has to plan around it being down.",
          "process": "The quarterly product commitment and the running incident queue are our two inputs. We ship in two-week iterations behind feature flags and hold a weekly reliability review where SRE brings the numbers rather than the anecdotes.",
          "owns": [
            "p95 API latency",
            "uptime",
            "the deploy pipeline",
            "the service catalogue",
            "the security posture"
          ],
          "dependsOn": [
            "product"
          ]
        }
      },
      {
        "id": "people",
        "name": "People",
        "parent": "exec",
        "charter": {
          "mission": "We make sure the company can hire, keep and grow the people the operating plan quietly assumes it already has.",
          "process": "A rolling hiring plan runs against the operating plan, a compensation and performance cycle runs twice a year, and a quarterly engagement survey goes to the exec review with the bad news left in.",
          "owns": [
            "the hiring plan",
            "attrition",
            "the compensation bands",
            "onboarding"
          ],
          "dependsOn": [
            "exec"
          ]
        }
      },
